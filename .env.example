# Public configuration only. Never put secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_google_maps_key
# Use an Android-app-restricted key for release builds.
GOOGLE_MAPS_ANDROID_API_KEY=your_android_google_maps_key
# Optional: configure Google Maps on iOS builds as well.
GOOGLE_MAPS_IOS_API_KEY=your_ios_google_maps_key
